---
import type { SpecialtyService } from '@/data/services';
import { getWhatsAppUrl } from '@/utils/contact';
import { ArrowRightIcon } from './icons';
import SpecialtyIcon from './SpecialtyIcon.astro';

interface Props {
  service: SpecialtyService;
  index: number;
  /** Featured cells show the `media` slot instead of the line icon. */
  featured?: boolean;
  delay?: number;
  class?: string;
}

const { service, index, featured = false, delay = 0, class: className } = Astro.props;
const titleId = `especialidad-${service.id}`;
---

<article
  aria-labelledby={titleId}
  style={`--delay: ${delay}ms`}
  class:list={[
    'group relative isolate flex flex-col bg-canvas',
    'has-[a:focus-visible]:outline-2 has-[a:focus-visible]:-outline-offset-2 has-[a:focus-visible]:outline-accent',
    className,
  ]}
>
  <span
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-surface opacity-0 transition-opacity duration-500 ease-smooth group-hover:opacity-100"
  ></span>
  {
    featured && (
      <div
        data-reveal
        class="relative aspect-[4/3] overflow-hidden bg-surface lg:aspect-auto lg:min-h-[22rem] lg:flex-1"
      >
        <slot name="media" />
      </div>
    )
  }

  <div data-reveal class:list={['flex flex-col p-6 sm:p-8', !featured && 'flex-1']}>
    <div class="flex items-start justify-between gap-6">
      {
        !featured && (
          <SpecialtyIcon
            name={service.icon}
            class="size-11 text-fg transition-colors duration-500 ease-smooth group-hover:text-accent"
          />
        )
      }
      <span class="ml-auto font-mono text-label text-fg-subtle tabular-nums">{String(index + 1).padStart(2, '0')}</span>
    </div>

    <div class:list={[featured ? 'mt-2' : 'mt-auto pt-10 sm:pt-12']}>
      <h3
        id={titleId}
        class:list={['font-medium tracking-[-0.02em] text-balance', featured ? 'text-title' : 'text-xl sm:text-[1.375rem]']}
      >
        {service.title}
      </h3>
      <p class="mt-3 max-w-[30rem] text-[15px] leading-relaxed text-pretty text-fg-muted">{service.description}</p>
      <a
        href={getWhatsAppUrl(service.whatsappMessage)}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-flex items-center gap-2 text-[13px] font-medium text-fg-muted transition-colors duration-300 group-hover:text-fg after:absolute after:inset-0 focus-visible:outline-none"
      >
        Consultar
        <span class="sr-only">{service.title} por WhatsApp (se abre en una pestaña nueva)</span>
        <ArrowRightIcon
          className="size-3.5 transition-[translate,color] duration-300 ease-smooth group-hover:translate-x-1 group-hover:text-accent"
        />
      </a>
    </div>
  </div>
</article>
