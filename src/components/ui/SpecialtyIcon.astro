---
import type { SpecialtyIcon } from '@/data/services';

interface Props {
  name: SpecialtyIcon;
  class?: string;
}

const { name, class: className } = Astro.props;

/** Shared motion for the moving part of each icon; triggered by the parent `group`. */
const part = 'transition-[translate,rotate,color,opacity] duration-500 ease-smooth [transform-box:fill-box]';
---

<svg
  viewBox="0 0 32 32"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon-draw', className]}
>
  {
    name === 'safe' && (
      <>
        <rect x="5" y="5" width="22" height="20" rx="1.5" pathLength="1" />
        <path d="M9 25v2.5M23 25v2.5M23.5 12v6" pathLength="1" />
        <g class:list={[part, 'origin-center group-hover:rotate-90']}>
          <circle cx="14.5" cy="15" r="5" pathLength="1" />
          <path d="M14.5 10v2M14.5 18v2M9.5 15h2M17.5 15h2" pathLength="1" />
        </g>
      </>
    )
  }
  {
    name === 'broken-key' && (
      <>
        <circle cx="8.5" cy="16" r="4.5" pathLength="1" />
        <path d="M13 16h4l1-1.5" pathLength="1" />
        <g class:list={[part, 'group-hover:translate-x-[2px] group-hover:-translate-y-[1px] group-hover:rotate-6']}>
          <path d="M19.5 17.5 20.5 16H28M25 16v3M27.5 16v2" pathLength="1" />
        </g>
      </>
    )
  }
  {
    name === 'chip-key' && (
      <>
        <rect x="4" y="10" width="11" height="14" rx="3" pathLength="1" />
        <path d="M7.5 14.5h4M7.5 18h4M15 17h13M25 17v3M22 17v2" pathLength="1" />
        <g class:list={[part, 'opacity-40 group-hover:-translate-y-[1px] group-hover:opacity-100 group-hover:text-accent']}>
          <path d="M7 7a5 5 0 0 1 5 0M5.5 4.5a8 8 0 0 1 8 0" pathLength="1" />
        </g>
      </>
    )
  }
  {
    name === 'master-key' && (
      <>
        <g class:list={[part, 'group-hover:translate-y-[2px]']}>
          <circle cx="8" cy="9" r="3.5" pathLength="1" />
          <path d="M11.5 9H27M24 9v2.5M21 9v2" pathLength="1" />
        </g>
        <g class:list={[part, 'group-hover:text-accent']}>
          <circle cx="8" cy="23" r="3.5" pathLength="1" />
          <circle cx="16" cy="23" r="3.5" pathLength="1" />
          <circle cx="24" cy="23" r="3.5" pathLength="1" />
          <path d="M8 22v2M16 22v2M24 22v2" pathLength="1" />
        </g>
      </>
    )
  }
  {
    name === 'key-copy' && (
      <>
        <g opacity="0.45">
          <circle cx="8.5" cy="11" r="4" pathLength="1" />
          <path d="M12.5 11H27M24 11v2.5M21 11v2" pathLength="1" />
        </g>
        <g class:list={[part, 'group-hover:-translate-y-[6px]']}>
          <circle cx="8.5" cy="20" r="4" pathLength="1" />
          <path d="M12.5 20H27M24 20v2.5M21 20v2" pathLength="1" />
        </g>
      </>
    )
  }
  {
    name === 'padlock' && (
      <>
        <rect x="7.5" y="15" width="17" height="12" rx="2" pathLength="1" />
        <path d="M16 19.5v3" pathLength="1" />
        <g class:list={[part, 'group-hover:-translate-y-[3px]']}>
          <path d="M11 15v-4a5 5 0 0 1 10 0v4" pathLength="1" />
        </g>
      </>
    )
  }
</svg>
