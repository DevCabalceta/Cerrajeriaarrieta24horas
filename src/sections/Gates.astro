---
import { Picture } from 'astro:assets';
import installationImage from '@/assets/images/gate-installation.jpg';
import { gateMotors, gateQuoteMessage, gateServices } from '@/data/services';
import { contact } from '@/data/site';
import { getPhoneUrl, getWhatsAppUrl } from '@/utils/contact';
import { CtaLink } from '@/components/ui/CtaLink';
import SectionHeader from '@/components/ui/SectionHeader.astro';
import GateSimulator from '@/components/interactive/GateSimulator';
---

<section id="portones" aria-labelledby="portones-title">
  <div class="container-page py-24 sm:py-32 lg:py-40">
    <SectionHeader
      index="05"
      label="Portones eléctricos"
      titleId="portones-title"
      title="Portones que abren"
      titleMuted="cuando usted lo necesita."
      description="Reparación, mantenimiento y automatización de portones eléctricos a domicilio, con motores de cremallera, cadena y pistones."
    />

    <div class="mt-14 grid gap-14 lg:mt-20 lg:grid-cols-12 lg:gap-12">
      <div data-reveal class="lg:col-span-7">
        <GateSimulator client:visible={{ rootMargin: '200px' }} motors={gateMotors} />
      </div>

      <div class="lg:col-span-5">
        <p data-reveal class="font-mono text-label text-fg-subtle uppercase">Qué hacemos</p>
        <ol class="mt-5">
          {
            gateServices.map((service, index) => (
              <li class="relative">
                <span
                  aria-hidden="true"
                  data-reveal="line"
                  class="absolute inset-x-0 top-0 h-px origin-left bg-line"
                  style={`--delay: ${80 + index * 80}ms`}
                />
                <div data-reveal class="grid grid-cols-[2.25rem_1fr] gap-x-3 py-5" style={`--delay: ${120 + index * 80}ms`}>
                  <span class="pt-1 font-mono text-label text-fg-subtle tabular-nums">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <h3 class="text-lg font-medium tracking-[-0.015em]">{service.title}</h3>
                    <p class="mt-1.5 text-[15px] leading-relaxed text-pretty text-fg-muted">{service.description}</p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        <span aria-hidden="true" data-reveal="line" class="block h-px origin-left bg-line [--delay:400ms]"></span>
      </div>
    </div>

    <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:items-end lg:gap-12">
      <figure data-reveal class="group lg:col-span-5">
        <div class="aspect-[4/3] overflow-hidden bg-surface">
          <Picture
            src={installationImage}
            alt="Técnico de Cerrajería Arrieta preparando el motor de un portón eléctrico"
            formats={['avif', 'webp']}
            widths={[480, 720, 840]}
            sizes="(min-width: 1024px) 38vw, 100vw"
            class="size-full object-cover object-[50%_30%] brightness-90 grayscale transition-[filter,scale] duration-700 ease-smooth group-hover:scale-[1.03] group-hover:grayscale-0"
          />
        </div>
        <figcaption class="mt-3 flex items-center justify-between font-mono text-label text-fg-subtle uppercase">
          <span>Instalación de motor</span>
          <span>Trabajo real</span>
        </figcaption>
      </figure>

      <div data-reveal class="lg:col-span-7 lg:pb-8 lg:pl-8 [--delay:120ms]">
        <p class="font-mono text-label text-fg-subtle uppercase">Cotización</p>
        <p class="mt-4 max-w-[26ch] text-title font-medium text-balance">
          ¿Su portón necesita atención? Le preparamos una cotización personalizada.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <CtaLink href={getWhatsAppUrl(gateQuoteMessage)} icon="whatsapp" external>Solicitar cotización</CtaLink>
          <CtaLink
            href={getPhoneUrl()}
            variant="secondary"
            icon="phone"
            detail={contact.phone.display}
            ariaLabel={`Llamar al ${contact.phone.display}`}
          >
            Llamar
          </CtaLink>
        </div>
      </div>
    </div>
  </div>
</section>
