---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/sections/Hero.astro';
import CompanyIntro from '@/sections/CompanyIntro.astro';
import Services from '@/sections/Services.astro';
import SpecialtyServices from '@/sections/SpecialtyServices.astro';
import Emergency from '@/sections/Emergency.astro';
import Gates from '@/sections/Gates.astro';
import Coverage from '@/sections/Coverage.astro';
import About from '@/sections/About.astro';
import FinalCta from '@/sections/FinalCta.astro';
import FloatingActions from '@/components/interactive/FloatingActions';
import { social } from '@/data/site';
import { getWhatsAppUrl } from '@/utils/contact';
---

<BaseLayout>
  <main id="main">
    <Hero />
    <CompanyIntro />
    <Services />
    <SpecialtyServices />
    <Emergency />
    <Gates />
    <Coverage />
    <About />
    <FinalCta />
  </main>
  <FloatingActions
    client:idle
    contactTriggerId="hero-actions"
    topTriggerId="inicio"
    focusId="hero-title"
    whatsappUrl={getWhatsAppUrl()}
    facebookUrl={social.facebook}
  />
</BaseLayout>
